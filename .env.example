# Leave empty for local-development mode.
PDM_API_KEYS=
# Protected deployment example (do not commit real values; use generated keys of 32+ characters):
# PDM_API_KEYS=planner:replace-with-generated-secret-32-chars-min,viewer:replace-with-generated-read-key-32-chars
PDM_SECRET_PROVIDER=
PDM_SECRET_ROTATION_POLICY=
PDM_SECRET_ROTATION_TESTED_AT=
PDM_DEPLOYMENT_EVIDENCE_FILE=
PDM_FIELD_QUALIFICATION_EVIDENCE_FILE=
PDM_RELEASE_ID=
PDM_DEPLOYMENT_ENVIRONMENT=
PDM_RELEASE_ARTIFACT_SHA256=
PDM_READINESS_PROBE_DATABASE=0
# Set to 1 in non-production environments that must fail orchestration
# readiness until the structured deployment gate passes. Production auth mode
# enables this behavior automatically.
PDM_REQUIRE_PRODUCTION_READINESS=0
PDM_TLS_INGRESS_ID=
PDM_OBSERVABILITY_ENABLED=0
PDM_METRICS_EXPORTER=
PDM_LOG_SINK=
PDM_TRACE_EXPORTER=
PDM_ALERT_ROUTING=
PDM_BACKUP_POLICY=
PDM_BACKUP_TARGET=
PDM_RESTORE_TESTED_AT=
PDM_CMMS_CONNECTOR_MODE=reference
PDM_CMMS_CONNECTOR_ID=
PDM_CMMS_CONNECTOR_ENDPOINT=

# Local state locations. Relative paths resolve from the runtime working directory.
PDM_STATE_DB=data/pdm.db
PDM_STATE_BACKEND=sqlite
# Production must provide the managed PostgreSQL adapter and a secret-backed URL.
PDM_MANAGED_STATE_ADAPTER=sqlalchemy
# Install the managed extra (psycopg) and set PDM_STATE_BACKEND=managed only
# after database connectivity and migration checks pass.
PDM_EXTERNAL_DATA_ROOT=data/external
PDM_EXTERNAL_MODEL_ROOT=data/external_models
PDM_REQUIRE_APPROVED_MODELS=0
PDM_CHANGE_TICKET_STATUS=

# Never commit database passwords, API keys, Gurobi WLS credentials, license files, or private keys.
# SQL connection URLs with credentials are entered at runtime and are intentionally excluded from dataset manifests.

# Local-only MetroPT-3 runtime (raw data, derived features, and local models)
PDM_METROPT_ROOT=data/external/metropt3
